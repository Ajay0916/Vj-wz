+            if error:
+                row += f"\n  <i>{escape(error[:90])}</i>"
+            lines.append(row)
+        if len(cooling) > 10:
+            lines.append(f"• +{len(cooling) - 10} more")
+
+    if recent_fails:
+        lines.append("\n<b>⚠️ Recent Failures</b>")
